NODE_ENV=production
PORT=7856

# Required: MongoDB connection string for a least-privilege application user.
MONGO_URI=mongodb+srv://<app-user>:<password>@<cluster>/<database>
DB_NAME=ngo_management_db

# Required: generate with a cryptographically secure random generator; minimum 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=ngo-api
JWT_AUDIENCE=ngo-web

# Comma-separated exact frontend origins. No wildcard in production.
FRONTEND_URL=https://www.example-ngo.org

# Explicitly configure proxy trust only for the actual deployment topology.
# Examples: 1, 2, false, or a comma-separated list of trusted proxy addresses.
TRUST_PROXY=1

# Cookie policy. Keep strict for same-site deployments.
# Use none only when frontend and API are on different sites; it requires HTTPS and COOKIE_SECURE=true.
COOKIE_SAMESITE=strict
COOKIE_SECURE=true

# Payment secrets: configure only in the deployment secret manager.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
PHONEPE_MERCHANT_ID=replace-me
PHONEPE_SALT_KEY=replace-me
PAYUMONEY_MERCHANT_KEY=replace-me
PAYUMONEY_SALT=replace-me

# SMTP secrets: configure only in the deployment secret manager.
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USER=replace-me
EMAIL_PASSWORD=replace-me
EMAIL_FROM=NGO <noreply@example.org>
