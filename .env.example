# NGO Management System - Environment Configuration

# Backend Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017
DB_NAME=ngo_db

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=NGO Management <noreply@ngo.org>

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# PayU Money Payment Gateway
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt

# File Upload (Optional - for cloud storage)
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Organization Details
ORG_NAME=Your NGO Name
ORG_EMAIL=contact@ngo.org
ORG_PHONE=+91-XXXXXXXXXX
ORG_ADDRESS=Your Organization Address

# Features Toggle
ENABLE_WHATSAPP_INTEGRATION=false
ENABLE_80G_CERTIFICATES=true
ENABLE_MULTI_LANGUAGE=false
