# NGO environment reference. Keep real secrets in local/deployment secret stores.

# Backend
NODE_ENV=development
PORT=7856
MONGO_URI=mongodb://localhost:27017
DB_NAME=ngo_db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=ngo-api
JWT_AUDIENCE=ngo-web
FRONTEND_URL=http://localhost:8080
TRUST_PROXY=0
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Razorpay (server-side secrets; never expose the secret)
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# SMTP
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USER=replace-me
EMAIL_PASSWORD=replace-me
EMAIL_FROM=NGO <noreply@example.org>

# Frontend build-time public configuration
# The client accepts either the API origin or the API /api base.
VITE_API_URL=http://localhost:7856/api
